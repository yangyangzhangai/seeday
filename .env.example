# =========================================
# Server-only API keys (never expose to src/**)
# =========================================

# 默认所有 AI 使用 DeepSeek；legacy 恢复原 OpenAI/Gemini 分工（需对应密钥）。
# 只在服务端配置；具体端点/语言映射见 docs/AI_USAGE_INVENTORY.md。
AI_PROVIDER_MODE=deepseek
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 以下供应商默认不调用，仅 legacy 模式需要。
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 可选：legacy 模式的功能级模型覆盖；默认模式忽略这些旧模型变量。
CLASSIFY_MODEL=deepseek-flash
TODO_DECOMPOSE_MODEL_ZH=deepseek-flash
TODO_DECOMPOSE_MODEL=gemini-2.5-flash
TODO_DECOMPOSE_GEMINI_BASE_URL=
TODO_DECOMPOSE_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
PROFILE_EXTRACT_MODEL=gpt-4o-mini
MAGIC_PEN_MODEL=deepseek-flash

# 可选：功能级 DeepSeek base URL / key 覆盖。
ANNOTATION_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MAGIC_PEN_DEEPSEEK_API_KEY=
MAGIC_PEN_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：诊断日志开关。
ANNOTATION_VERBOSE_LOGS=false
TODO_DECOMPOSE_VERBOSE_LOGS=false
MAGIC_PEN_DEBUG=0

# =========================================
# iOS (Capacitor) API base
# =========================================

# iOS 包不包含 Vercel Functions，必须在构建时指向生产后端。
# Web 构建可留空并使用相对路径 /api。
VITE_API_BASE=https://seedayapp.com

# =========================================
# Supabase
# =========================================

VITE_SUPABASE_URL=https://oxsbukofipeoikirkyyy.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional OAuth redirect URL for Capacitor native app.
VITE_IOS_OAUTH_REDIRECT_URL=com.seeday.app://auth/callback

# Server only. Required by account deletion and admin telemetry APIs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional allowlist for live-input telemetry dashboard access.
LIVE_INPUT_ADMIN_EMAILS=your_admin_email@example.com
LIVE_INPUT_ADMIN_USER_IDS=

# Raw user input telemetry is disabled by default.
LIVE_INPUT_TELEMETRY_STORE_RAW_TEXT=false

# =========================================
# Local dev / QA switches
# =========================================

VITE_FORCE_ONBOARDING=false

# =========================================
# Membership / iOS IAP
# =========================================

VITE_PAYMENT_MODE=iap
VITE_IAP_PRODUCT_MONTHLY=seeday.pro.monthly
VITE_IAP_PRODUCT_ANNUAL=seeday.pro.annual

APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.seeday.app
APPLE_IAP_PRODUCT_MONTHLY=seeday.pro.monthly
APPLE_IAP_PRODUCT_ANNUAL=seeday.pro.annual

# Sign in with Apple revoke credentials are distinct from App Store Connect IAP credentials.
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_SIGN_IN_CLIENT_ID=com.seeday.app

# Local debug only.
APPLE_IAP_VERIFY_BYPASS=false

# =========================================
# Membership / Web Stripe
# =========================================

STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
